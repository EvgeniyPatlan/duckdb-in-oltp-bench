# MySQL 9.7 InnoDB baseline. Rendered by dbench/systems/baseline_conf.py (jinja2) from the
# container limits and mounted read-only at /etc/mysql/conf.d/dbench.cnf.
# Sizing formulas (mem_gb = container memory, cores = CPUs in the DB cpuset):
#   innodb_buffer_pool_size       = 0.75 * mem_gb       (64 GB / 16 cores -> 48G)
#   innodb_parallel_read_threads  = cores               (64 GB / 16 cores -> 16)
#   tmp_table_size = max_heap_table_size = temptable_max_ram = mem_gb / 16   (-> 4G)
#   innodb_redo_log_capacity      = mem_gb / 8          (-> 8G)
#   join_buffer_size = sort_buffer_size = 256M, the same per-operation memory as Postgres work_mem
[mysqld]
# Binary logging is off on every MySQL-family server (MySQL and Percona enable it by default,
# MariaDB does not): replication is not under test and the default differs between families.
skip-log-bin
# 75% of container memory for the buffer pool; the rest covers connections, sort and join buffers.
innodb_buffer_pool_size = {{ buffer_pool }}
# Only COUNT(*) without WHERE and CHECK TABLE use parallel read threads; ordinary scans stay
# single-threaded in MySQL. Set to every core given to the database so those two are not held back.
innodb_parallel_read_threads = {{ read_threads }}
# Server-side LOAD DATA INFILE may read only the read-only dataset mount.
secure_file_priv = /data
# Bulk load is server-side from /data; client-side LOCAL loads stay disabled.
local_infile = OFF
# Headroom for the 32-stream throughput run plus probes and cancel connections.
max_connections = 200
# Per-join memory comparable to Postgres work_mem=256MB, so hash and block-nested joins do not spill.
join_buffer_size = 256M
# Per-sort memory comparable to Postgres work_mem=256MB, so ORDER BY and GROUP BY sorts stay in RAM.
sort_buffer_size = 256M
# Internal temporary tables (GROUP BY, DISTINCT, derived tables) stay in memory up to mem_gb/16.
tmp_table_size = {{ temp_ram }}
# Same cap for MEMORY-engine temporary tables, which use the smaller of the two sizes.
max_heap_table_size = {{ temp_ram }}
# RAM the TempTable engine may use before spilling to disk, equal to the caps above.
temptable_max_ram = {{ temp_ram }}
# A redo log of mem_gb/8 keeps checkpoints from throttling bulk load at the 100MB default.
innodb_redo_log_capacity = {{ redo_capacity }}
