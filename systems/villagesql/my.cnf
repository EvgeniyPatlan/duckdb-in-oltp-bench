# VillageSQL Server 0.0.7 (MySQL 8.4) with vsql_duckdb 0.0.3: the MySQL side. Rendered by
# dbench/systems/villagesql.py (jinja2) from the container limits and mounted read-only at
# /etc/my.cnf. The extension's own settings are in settings.sql (SET PERSIST, run at first start).
# Lines starting with '#' are the reason for the setting below them.
# Sizing formulas (mem_gb = container memory, cores = CPUs in the DB cpuset), the same ones the
# MySQL-family DuckDB engines use (baseline_conf.duckdb_engine_settings):
#   innodb_buffer_pool_size = mem_gb / 16   (64 GB -> 4G); InnoDB only holds the small joined
#                                           table (nation); the data stays in Parquet files
#   tmp_table_size = max_heap_table_size = temptable_max_ram = mem_gb / 16   (-> 4G)
#   innodb_redo_log_capacity = mem_gb / 8   (-> 8G)
[mysqld]
# Binary logging is off on every MySQL-family server (MySQL, Percona and AliSQL enable it by
# default, MariaDB does not): replication is not under test and the default differs between families.
skip-log-bin
# The InnoDB side only holds the small table the JSON_TABLE join example uses; the analytical data
# is read by DuckDB from Parquet, so a large pool would only take memory from DuckDB.
innodb_buffer_pool_size = {{ buffer_pool }}
# Same as the other MySQL-family servers: every core for the two operations that use parallel reads.
innodb_parallel_read_threads = {{ cores }}
# Same redo log capacity as the InnoDB baseline.
innodb_redo_log_capacity = {{ redo_capacity }}
# Per-join memory comparable to Postgres work_mem=256MB, same as the InnoDB baseline.
join_buffer_size = 256M
# Per-sort memory comparable to Postgres work_mem=256MB, same as the InnoDB baseline.
sort_buffer_size = 256M
# Internal temporary tables stay in memory up to mem_gb/16, same as the InnoDB baseline.
tmp_table_size = {{ temp_ram }}
# Same cap for MEMORY-engine temporary tables, which use the smaller of the two sizes.
max_heap_table_size = {{ temp_ram }}
# RAM the TempTable engine may use before spilling, equal to the caps above.
temptable_max_ram = {{ temp_ram }}
# Server-side LOAD DATA INFILE (the nation table of the join example) may read only the dataset mount.
secure_file_priv = /data
# Loads are server-side from /data; client-side LOCAL loads stay disabled.
local_infile = OFF
# Headroom for probes and cancel connections.
max_connections = 200
# vsql_duckdb returns utf8mb4 text; the server default is already utf8mb4, set so it cannot change.
character-set-server = utf8mb4
