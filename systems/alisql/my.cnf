# AliSQL 8.0.44-3 with the DuckDB storage engine. Rendered by dbench/systems/alisql.py (jinja2)
# from the container limits and mounted read-only at /etc/alisql/dbench.cnf (mysqld --defaults-file).
# Lines starting with '#' are the reason for the setting below them.
# Sizing formulas (mem_gb = container memory, cores = CPUs in the DB cpuset), the same ones the
# Percona and MariaDB engines use (baseline_conf.py):
#   duckdb_memory_limit          = 0.75 * mem_gb   (64 GB -> 48G)
#   duckdb_threads               = cores           (16 cores -> 16)
#   innodb_buffer_pool_size      = mem_gb / 16     (-> 4G); InnoDB only holds catalog + staging
#   tmp_table_size = max_heap_table_size = temptable_max_ram = mem_gb / 16   (-> 4G)
#   innodb_redo_log_capacity     = mem_gb / 8      (-> 8G)
[mysqld]
# The engine is off unless the server is started with duckdb_mode=ON (static, default NONE).
duckdb_mode = ON
# Caps DuckDB (the engine that runs the queries) at 75% of the container, the share the InnoDB
# baseline gives its buffer pool; the rest covers the server, connections and the OS. The engine
# default 0 means about 80% of physical RAM of the host, not of the container cgroup.
duckdb_memory_limit = {{ duck_memory }}
# One DuckDB thread per core pinned to the database container (default 0 = auto).
duckdb_threads = {{ cores }}
# Explicit spill location on the datadir volume (created by the image entrypoint), the same
# spill-location rule as every engine. duckdb_max_temp_directory_size stays at its default 0, which
# the variable documentation defines as 90% of the free disk, so spilling is not capped.
duckdb_temp_directory = {{ spill_dir }}
# Exact TPC-H DECIMAL results (set explicitly, disclosed). The default ON maps DECIMAL with
# precision > 38 to DOUBLE; the benchmark schema has none, but MariaDB gets the same setting.
duckdb_use_double_for_decimal = OFF
# Queries reach DuckDB exactly as written, with no MySQL-to-DuckDB rewriting (the default,
# set explicitly and disclosed): a query the engine rejects is recorded as an error.
duckdb_sql_normalization = OFF
# Every DuckDB table must have a primary key (the default, set explicitly); the schema declares them.
duckdb_require_primary_key = ON
# The InnoDB side only holds the catalog and row-store staging (the load_convert path); the data
# lives in DuckDB, so a large pool would only take memory from DuckDB.
innodb_buffer_pool_size = {{ buffer_pool }}
# Same as the InnoDB baseline. Only COUNT(*) without WHERE and CHECK TABLE use parallel read
# threads (ordinary scans stay single-threaded); set to every core so those two are not held back.
innodb_parallel_read_threads = {{ cores }}
# A redo log of mem_gb/8 keeps checkpoints from throttling the row-store staging load; same
# capacity as the InnoDB baseline.
innodb_redo_log_capacity = {{ redo_capacity }}
# Per-join memory comparable to Postgres work_mem=256MB, same as the InnoDB baseline.
join_buffer_size = 256M
# Per-sort memory comparable to Postgres work_mem=256MB, same as the InnoDB baseline.
sort_buffer_size = 256M
# Internal temporary tables stay in memory up to mem_gb/16, same as the InnoDB baseline.
tmp_table_size = {{ temp_ram }}
# Same cap for MEMORY-engine temporary tables, which use the smaller of the two sizes.
max_heap_table_size = {{ temp_ram }}
# RAM the TempTable engine may use before spilling, equal to the caps above.
temptable_max_ram = {{ temp_ram }}
# Server-side LOAD DATA INFILE may read only the read-only dataset mount.
secure_file_priv = /data
# Bulk load is server-side from /data; client-side LOCAL loads stay disabled.
local_infile = OFF
# Headroom for the 32-stream throughput run plus probes and cancel connections.
max_connections = 200
