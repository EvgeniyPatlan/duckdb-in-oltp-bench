<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}DuckDB in OLTP databases{% endblock %}{% if synthetic %} (SYNTHETIC DATA){% endif %}</title>
<link rel="stylesheet" href="{{ root }}static/style.css">
</head>
<body data-page="{{ page }}">
<header class="top">
  <a class="brand" href="{{ root }}index.html">DuckDB inside OLTP databases</a>
  <nav aria-label="Pages">
    <a href="{{ here }}index.html">Overview</a>
    <a href="{{ here }}track_a.html">Track A</a>
    <a href="{{ here }}track_b.html">Track B</a>
    <a href="{{ here }}explore.html">Explore</a>
    <a href="{{ root }}reports.html">Reports</a>
    <a href="{{ root }}methodology.html">Methodology</a>
    <details class="menu"><summary>Systems</summary>
      <div>{% for s in nav_systems %}<a href="{{ root }}systems/{{ s.slug }}">{{ s.label }}</a>{% endfor %}</div>
    </details>
  </nav>
  {% if reports %}
  <label class="switch">Report
    <select id="report-switch" data-root="{{ root }}" data-page="{{ page if page in ('index', 'track_a', 'track_b', 'explore') else 'index' }}">
      <option value=""{{ " selected" if not report.id }}>All results (latest run per system)</option>
      {% for r in reports %}<option value="{{ r.url }}"{{ " selected" if r.id == report.id }}>{{ r.id }} (SF{{ r.sfs | join(", SF") }}{{ ", " ~ r.finished if r.finished }})</option>{% endfor %}
    </select></label>
  {% endif %}
</header>
{% if report.id %}
<div class="reportbar">Report <strong>{{ report.id }}</strong>: scale factor {{ report.sfs | join(", ") }}, measured {{ report.started }}{% if report.finished != report.started %} to {{ report.finished }}{% endif %}.
  Only this campaign's records are shown. <a href="{{ root }}index.html">All results</a></div>
{% endif %}
{% if synthetic %}
<div class="banner" role="alert"><strong>SYNTHETIC DATA.</strong> Every number on this site comes from a test fixture
  generated by a seeded script. Nothing was measured and nothing here says anything about any real system.</div>
{% endif %}
<main>
{% block content %}{% endblock %}
</main>
<footer>
  <p>{% if empty %}This site is generated from the result files in the repository; none are published yet.{% else %}All systems are shown with the same layout, scales and limits. Raw result files are in the repository; this site is generated from them.{% endif %}
  {% if run_ids %}Runs: {{ run_ids | join(", ") }}.{% endif %}</p>
  {% if excluded_runs %}
  <p>Each system, track and scale factor shows one run, the one with the most records (the newest on a tie); also present, not shown:
    {% for e in excluded_runs %}{{ e.system }} SF{{ e.sf }}: run {{ e.run_id }} ({{ e.records }} records){{ "; " if not loop.last }}{% endfor %}.</p>
  {% endif %}
</footer>
<script src="{{ root }}static/nav.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
